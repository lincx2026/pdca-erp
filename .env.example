# Copy to .env. Use unquoted values (Spring imports this file as properties).
# scripts/init-env.py creates .env with random database/Redis/JWT/admin secrets.
POSTGRES_DB=pcba_erp
POSTGRES_USER=pcba
POSTGRES_VOLUME_NAME=pcba-erp-postgres-data
POSTGRES_PASSWORD=replace-with-random-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=disable
DB_POOL_SIZE=30
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRE_MINUTES=720
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-admin-password
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=
ERP_DOMAIN=erp.thinkfiter.com
CORS_ALLOWED_ORIGINS=https://erp.thinkfiter.com,http://localhost:5180
API_DOCS_ENABLED=false
IMAGE_TAG=local
JAVA_OPTS=-Xms512m -Xmx2g -XX:+UseG1GC -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai
# Use shared on ECS with existing host PostgreSQL and Nginx (Linux, Compose >=2.24.4).
DEPLOY_MODE=standalone
ERP_HTTP_PORT=18080
BACKEND_PORT=18081
ERP_REDIS_PORT=16379
# In shared mode, reference existing valid host certificate files.
ERP_TLS_CERT=/etc/letsencrypt/live/your-domain/fullchain.pem
ERP_TLS_KEY=/etc/letsencrypt/live/your-domain/privkey.pem
# Opt in to certbot webroot issuance; paths above must then use the exact ERP_DOMAIN.
ERP_TLS_AUTO=false
